# ==============================================================================
# MJ PHOTOGRAPHY — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development (never commit .env.local).
# ==============================================================================

# Public Firebase Web SDK Configuration (Safe for browser bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (ReCaptcha Enterprise / v3 site key for production)
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# Optional local development App Check debug token (never enable in production)
# NEXT_PUBLIC_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Optional Firebase Local Emulator Suite toggle (set "true" for local emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Canonical site URL for SEO metadata, Open Graph, Sitemap & origin validation
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# SERVER-ONLY CREDENTIALS (NEVER prefix with NEXT_PUBLIC_)
# Provide EITHER FIREBASE_SERVICE_ACCOUNT_KEY (stringified JSON) OR the 3 discrete vars.
# ==============================================================================
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Optional: Strict App Check enforcement on API routes ("true" in production)
ENFORCE_APP_CHECK=false

# Optional: Admin Notification Webhook (e.g., Resend / SendGrid / Slack / Make)
BOOKING_NOTIFICATION_WEBHOOK_URL=
ADMIN_NOTIFICATION_EMAIL=

