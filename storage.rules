rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isValidImageUpload() {
      return request.resource != null &&
             request.resource.size > 0 &&
             request.resource.size <= 50 * 1024 * 1024 &&
             request.resource.contentType.matches('image/(jpeg|jpg|png|webp|avif|tiff)');
    }

    // Gallery originals (high-resolution, never destructively compressed)
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImageUpload();
      allow delete: if isAdmin();
    }

    // Optimized display thumbnails generated separately
    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImageUpload();
      allow delete: if isAdmin();
    }

    // Category covers
    match /categories/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImageUpload();
      allow delete: if isAdmin();
    }

    // Editorial story photography
    match /stories/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImageUpload();
      allow delete: if isAdmin();
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

